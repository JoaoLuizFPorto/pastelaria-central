{{> header}}
<main>
  <div class="mainPageContent"></div>
  <section class="shopPanel accountPanel authPanel">
    <h1>Criar conta</h1>
    <p>Preencha os dados abaixo para se cadastrar</p>
    {{#if error}}
      <p class="feedback error" role="alert">{{error}}</p>
    {{/if}}
    <form action="/signin" method="post" class="accountForm" data-confirm-password>
      <input type="hidden" name="_csrf" value="{{csrf}}">
      <label class="fieldLabel" for="firstName">Nome:</label>
      <input type="text" id="firstName" name="name" value="{{values.name}}" placeholder="Nome" autocomplete="given-name" minlength="2" maxlength="100" required>
      <label class="fieldLabel" for="surname">Sobrenome:</label>
      <input type="text" id="surname" name="surname" value="{{values.surname}}" placeholder="Sobrenome (opcional)" autocomplete="family-name" maxlength="100">
      <label class="fieldLabel" for="email">Email:</label>
      <input type="email" id="email" name="email" value="{{values.email}}" placeholder="Email" autocomplete="username" maxlength="254" required>
      <label class="fieldLabel" for="phone">Telefone com DDD:</label>
      <input type="tel" id="phone" name="phone" value="{{values.phone}}" placeholder="(19) 99999-9999" autocomplete="tel-national" maxlength="20" required>
      <div class="passwordWrapper">
        <label class="fieldLabel" for="initialPassword">Senha:</label>
        <div class="passwordInputControl">
          <input type="password" id="initialPassword" name="password" placeholder="Pelo menos 8 caracteres" autocomplete="new-password" minlength="8" maxlength="128" required>
          <button type="button" class="passwordEye" data-toggle-password="initialPassword" aria-label="Mostrar senha" aria-pressed="false">{{> password-toggle-icon}}</button>
        </div>
      </div>
      <div class="passwordWrapper">
        <label class="fieldLabel" for="confirmPassword">Confirme sua senha:</label>
        <div class="passwordInputControl">
          <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Repita a senha" autocomplete="new-password" minlength="8" maxlength="128" required>
          <button type="button" class="passwordEye" data-toggle-password="confirmPassword" aria-label="Mostrar senha" aria-pressed="false">{{> password-toggle-icon}}</button>
        </div>
      </div>
      <button type="submit" class="shopButton">Criar conta</button>
    </form>
    <p class="registerText">
      Já tem uma conta? <a href="/login">Entrar</a>
    </p>
  </section>
</main>
{{> footer}}
