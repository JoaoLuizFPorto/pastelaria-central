{{> header}}
<main>
  <div class="mainPageContent"></div>
  <section class="shopPanel accountPanel authPanel">
    <h1>Bem-vindo de volta</h1>
    <p>Acesse sua conta com email e senha</p>
    {{#if error}}
      <p class="feedback error" role="alert">{{error}}</p>
    {{/if}}
    <form action="/login" method="post" class="accountForm">
      <input type="hidden" name="_csrf" value="{{csrf}}">
      <label class="fieldLabel" for="email">Email:</label>
      <input type="email" id="email" name="email" value="{{values.email}}" placeholder="exemplo@exemplo.com" autocomplete="username" maxlength="254" required>
      <div class="passwordWrapper">
        <label class="fieldLabel" for="passwordLogin">Senha:</label>
        <div class="passwordInputControl">
          <input type="password" id="passwordLogin" name="password" placeholder="********" autocomplete="current-password" maxlength="128" required>
          <button type="button" class="passwordEye" data-toggle-password="passwordLogin" aria-label="Mostrar senha" aria-pressed="false">{{> password-toggle-icon}}</button>
        </div>
      </div>
      <div class="loginOptions">
        <label>
        <input type="checkbox" name="remember"> Lembrar de mim</label>
      </div>
      <button type="submit" class="shopButton">Entrar</button>
    </form>
    <p class="registerText">
      Não tem uma conta? <a href="/signin">Criar uma</a>
    </p>
  </section>
</main>
{{> footer}}
