{{> header}}
<main>
  <div class="mainPageContent"></div>
  <section class="shopPanel ordersPanel">
    <h1>Meus Pedidos</h1>
    {{#if registered}}
      <p class="feedback success" role="status">Pedido registrado! Você pode acompanhar os detalhes abaixo.</p>
    {{/if}}
    <p>Pedidos registrados na sua conta, sem cobrança online. Acompanhe as atualizações publicadas pela equipe.</p>
    {{#each orders}}
      <article class="orderCard">
        <div class="orderHeading">
          <h2>Pedido #{{id}}</h2>
          <span class="roleBadge" data-order-status="{{status}}">{{status}}</span>
        </div>
        <p>{{date}}</p>
        <ul class="adminOrderItems">
          {{#each items}}
            <li>
              <span>{{quantity}} × {{name}}</span><strong>{{subtotal}}</strong>
            </li>
          {{/each}}
        </ul>
        <p class="orderTotal">
          Total: <strong>{{totalDisplay}}</strong>
        </p>
        <a href="/meus-pedidos/{{id}}" class="shopButton orderTrackingButton">Acompanhar pedido</a>
      </article>
    {{else}}
      <div class="emptyState">
        <p>Você ainda não tem pedidos.</p>
        <a href="/cardapio" class="shopButton">Ver cardápio</a>
      </div>
    {{/each}}
  </section>
</main>
{{> footer}}
