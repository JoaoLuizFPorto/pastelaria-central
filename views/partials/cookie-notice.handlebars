{{#unless cookieNoticeSeen}}
  <aside id="cookieNotice" class="cookieNotice" aria-labelledby="cookieNoticeTitle">
    <div class="cookieNoticeHeading">
      <svg aria-hidden="true" viewBox="0 0 40 40" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M33 21a14 14 0 1 1-16-15c-1 6 3 10 8 9-1 5 3 8 8 6Z"/><g fill="currentColor" stroke="none"><circle cx="13" cy="17" r="2"/><circle cx="21" cy="26" r="2"/><circle cx="11" cy="26" r="1.5"/><circle cx="22" cy="19" r="1.5"/></g></svg>
      <h2 id="cookieNoticeTitle">Cookies na Pastelaria Central</h2>
      <button type="button" class="cookieNoticeClose dialogClose" data-dismiss-cookie-notice aria-label="Fechar aviso de cookies">×</button>
    </div>
    <p>Utilizamos cookies para o funcionamento do site e para oferecer uma melhor experiência de navegação. Ao utilizar nossos serviços, esses cookies são utilizados durante sua navegação.</p>
    <div class="cookieNoticeActions">
      <button type="button" class="shopButton" data-dismiss-cookie-notice>Entendi</button><a href="/privacyPolicy">Política de privacidade</a>
    </div>
  </aside>
{{/unless}}
