<section class="emptyPanel" aria-labelledby="emptyStateTitle">
  <div class="emptyPanelIcon" aria-hidden="true">
    <svg viewBox="0 0 48 48" width="48" height="48" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
    {{#if cart}}<path d="M5 8h6l5 24h22l5-17H13"/><circle cx="19" cy="40" r="2"/><circle cx="36" cy="40" r="2"/>
    {{else}}{{#if favorite}}<path d="M24 40 7 24C-3 12 13 0 24 13 35 0 51 12 41 24Z"/>
    {{else}}<circle cx="20" cy="20" r="12"/><path d="m29 29 11 11"/>{{/if}}{{/if}}
    </svg>
  </div>
  <h2 id="emptyStateTitle">{{title}}</h2>
  <p>{{description}}</p>
  <a href="/cardapio" class="shopButton">{{buttonText}} <span aria-hidden="true">→</span></a>
</section>
